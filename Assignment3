print("====================================")
print(" FIFA WORLD CUP 2026 SIMULATION ")
print("====================================")

morale = 50
strength = 50
injuries = 0

print("\nPRE-TOURNAMENT PREPARATION")

for week in range(1, 4):

    print("\nWeek", week)
    print("1. Training")
    print("2. Friendly Match")
    print("3. Recovery")

    choice = input("Choose activity: ")

    if choice == "1":
        strength += 10
        morale += 5
        print("Team trained hard.")

    elif choice == "2":
        morale += 10
        injuries += 1
        print("Friendly match played.")

    elif choice == "3":
        injuries -= 1
        if injuries < 0:
            injuries = 0
        morale += 3
        print("Players recovered.")

    else:
        print("Invalid choice.")
        continue

print("\nGROUP STAGE")

for match in range(1, 4):

    print("\nGroup Match", match)

    if injuries >= 5:
        print("Too many injuries. Match skipped.")
        continue

    print("1. Attack")
    print("2. Balanced")
    print("3. Defensive")

    tactic = input("Choose tactic: ")

    if tactic == "1":
        strength += 5
        morale += 5

    elif tactic == "2":
        morale += 2

    elif tactic == "3":
        strength -= 2

    else:
        print("Invalid tactic.")
        continue

    if strength + morale > 100:
        print("Match Won")
        morale += 5
    else:
        print("Match Lost")
        morale -= 5

    if morale <= 0:
        print("Team morale collapsed.")
        print("Tournament Lost")
        break

if morale > 0:

    print("\nKNOCKOUT STAGES")

    stages = ["Round of 16", "Quarter Final",
              "Semi Final", "Final"]

    for stage in stages:

        print("\n", stage)

        print("1. Train")
        print("2. Rest")

        option = input("Choose option: ")

        if option == "1":
            strength += 5
        elif option == "2":
            morale += 3
        else:
            pass

        if strength + morale >= 110:
            print("Won", stage)

        else:
            print("Lost", stage)
            print("Tournament Over")
            break

        if stage == "Final":
            print("\nCONGRATULATIONS!")
            print("You have won the FIFA World Cup 2026!")
            break

print("\nFinal Team Status")
print("Morale:", morale)
print("Strength:", strength)
print("Injuries:", injuries)